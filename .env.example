# Environment Variables Template — MediCare
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =========================
# Application
# =========================
ENVIRONMENT=development
APP_NAME=MediCare
APP_VERSION=0.1.0
DEBUG=true

# =========================
# Database (PostgreSQL)
# =========================
DATABASE_URL=postgresql+asyncpg://medicare_user:your_password@localhost:5432/medicare_db
DATABASE_URL_SYNC=postgresql://medicare_user:your_password@localhost:5432/medicare_db
POSTGRES_USER=medicare_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=medicare_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# JWT Authentication
# =========================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# AI / Gemini
# =========================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=8192

# =========================
# File Storage
# =========================
# Local storage for development
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# S3-compatible storage for production
STORAGE_BUCKET=medicare-documents
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_ENDPOINT_URL=https://s3.your-provider.com
STORAGE_REGION=us-east-1

# =========================
# Security
# =========================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=your-application-secret-key-change-in-production
BCRYPT_ROUNDS=12

# =========================
# Email (for verification/reset)
# =========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@medicare.example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=MediCare <noreply@medicare.example.com>

# =========================
# MLflow
# =========================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=medicare-research

# =========================
# Monitoring / Logging
# =========================
LOG_LEVEL=INFO
SENTRY_DSN=

# =========================
# Rate Limiting
# =========================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =========================
# Feature Flags
# =========================
ENABLE_AI=true
ENABLE_VOICE=true
ENABLE_ML=false
ENABLE_RAG=true
