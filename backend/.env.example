# MediCare AI - Environment Configuration Example

# App Configuration
APP_NAME=MediCare
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Primary: PostgreSQL (production or local Docker)
DATABASE_URL=postgresql+asyncpg://medicare_user:medicare_dev_password@localhost:5432/medicare_db
DATABASE_URL_SYNC=postgresql://medicare_user:medicare_dev_password@localhost:5432/medicare_db
# Local SQLite fallback (set to True for lightweight local testing without Postgres)
USE_SQLITE_FALLBACK=True
SQLITE_DB_URL=

# Cache / Redis (Optional in local development)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=change-me-in-production-super-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=change-me-in-production-super-secret-system-key
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS_RAW=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS_RAW=localhost,127.0.0.1

# AI Integration (Google Gemini)
# Configure your Gemini API key from https://aistudio.google.com/
# If left empty, MediCare AI safely uses its clinical document regex and terminology rule-engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=8192

# Feature Flags
ENABLE_AI=True
ENABLE_RAG=True
ENABLE_ML=False
